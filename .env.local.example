# =============================================================================
# STONE'S BARBER Web予約アプリ 環境変数
#
# このファイルを `.env.local` にコピーし、各値を設定してください。
# Vercelデプロイ時はダッシュボードから同じキーを登録します。
# =============================================================================

# --- アプリ ---
# 公開URL（メール内リンクに使用）
#   ローカル: http://localhost:3100
#   本番   : https://<プロジェクト名>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3100

# =============================================================================
# 入口の認証（2段構え）
#
#  1) お客様（Web予約画面）      … 下の Basic 認証
#  2) 店舗スタッフ（/admin）      … Supabase のメール + パスワード
#                                   （middleware.ts で /admin は Basic 認証を素通り）
# =============================================================================

# --- 1) Web予約画面の Basic 認証 ---
# ブラウザの認証ポップアップで聞かれる ID とパスワード。
# SITE_PASSWORD を空にすると認証なし（＝完全公開）になる。
SITE_USERNAME=STONES
SITE_PASSWORD=2018

# --- 2) 管理者アカウント ---
# アカウントは環境変数ではなく Supabase 側に作る。
#   node scripts/create-admin.mjs
# 既定では inotokoya1119@yahoo.co.jp を作成し admin ロールに昇格する。

# --- Supabase ---
# Supabase プロジェクトの URL と公開キー。
# https://supabase.com → 対象プロジェクト → Settings → API から取得。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# サービスロールキー。サーバーサイドでのみ使用（NEVER 公開）。
# 同じ画面の "service_role" を入れる。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Stripe（オンライン決済を使う場合のみ）---
# 空のままなら店舗払いのみで動作する。
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# メール送信（どちらか一方を設定すれば OK。両方あれば SMTP を優先）
# =============================================================================

# --- 方法 1: SMTP（推奨・ドメイン検証不要）---
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=yourshop@gmail.com
#   SMTP_PASS=<Google の「アプリ パスワード」（2段階認証の有効化が必要）>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 送信元表記（省略時は "STONE'S BARBER <SMTP_USER>"）
MAIL_FROM="STONE'S BARBER <inotokoya@yahoo.co.jp>"
# お客様が返信したときの宛先（任意）
MAIL_REPLY_TO=

# --- 方法 2: Resend（ドメイン検証が必要）---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# --- Cron ---
# Vercel Cron / 自前 cron が叩く /api/cron/* を保護するためのトークン。
# `openssl rand -hex 32` などで生成。
#
# ⚠ 紹介サイト側のアプリと同じ Supabase を共有する場合、
#    Cron を有効にするのは「どちらか一方だけ」にすること。
#    両方で動かすとリマインドメールとバックアップが二重に送られる。
CRON_SECRET=replace_with_a_random_64char_hex

# --- 管理者 ---
# 新規予約の通知が届く宛先（カンマ区切りで複数可・全員に届く）。
ADMIN_EMAILS=inotokoya@yahoo.co.jp
